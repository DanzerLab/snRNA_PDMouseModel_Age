allres_martirosyan <- "DESEQ2 results sheet for all tested genes from Martirosyan GABAergic Neuron PD vs Control , suppl table 6"
allres_smajic <- "DESEQ2 results sheet for all tested genes from Smajic GABAergic Neuron PD vs Control, suppl talbe 7"
pd_luciAge <- "DESEQ2 results sheet for only the significant genes from GABA-Rgs9 synON24M vs synOFF24M"
mh_data <- read.csv2(mouse_human_genes.csv, sep = ",")
pd_luciAge$gene_h <- mh_data$human[
  match(pd_luciAge$gene, mh_data$mouse)
]

# martirosyan
mart <- allres_martirosyan %>%
  dplyr::select(gene, log2FoldChange) %>%
  dplyr::filter(!is.na(gene), !is.na(log2FoldChange)) 

# smajic
smaj <- allres_smajic %>%
  dplyr::select(gene, log2FoldChange) %>%
  dplyr::filter(!is.na(gene), !is.na(log2FoldChange))

# luciAge (use gene_h)
luci <- pd_luciAge %>%
  dplyr::select(gene_h, log2FoldChange) %>%
  dplyr::filter(!is.na(gene_h), !is.na(log2FoldChange)) 

scale_to_four <- function(df, col = "log2FoldChange", new_col = "log2FoldChange_scaled") {
  # compute the maximum absolute value
  vals <- df[[col]]
  m    <- max(abs(vals), na.rm = TRUE)
  if (m == 0 || is.infinite(m)) {
    # if all zero or something’s weird, just fill zeros
    df[[new_col]] <- 0
    return(df)
  }
  # scale so that ±m → ±4
  df %>% mutate(!!new_col := !!sym(col) * (4 / m))
}

mart <- scale_to_four(mart, col = "log2FoldChange")
smaj <- scale_to_four(smaj, col = "log2FoldChange")
luci <- scale_to_four(luci, col = "log2FoldChange")

common_genes <- Reduce(intersect, list(mart$gene, smaj$gene, luci$gene_h))

mart_f <- mart %>% dplyr::filter(gene %in% common_genes) %>% mutate(sheet = "martirosyan")
smaj_f <- smaj %>% dplyr::filter(gene %in% common_genes) %>% mutate(sheet = "smajic")
luci_f <- luci %>% dplyr::filter(gene_h %in% common_genes) %>% mutate(sheet = "luciAge")
luci_f$gene <- luci_f$gene_h
luci_f$gene_h <- NULL
combined_df <- bind_rows(mart_f, smaj_f, luci_f)
combined_df$log2FoldChange <- NULL
heatmat <- combined_df %>%
  pivot_wider(names_from = gene, values_from = log2FoldChange_scaled) %>%
  column_to_rownames(var = "sheet")
heatmat <- t(heatmat)
breaks <- seq(-4, 4, length.out = 101)

# make a blue→white→red palette
palette <- colorRampPalette(c("navy", "white", "firebrick"))(100)

mart_f$log2FC_mart <- mart_f$log2FoldChange_scaled
smaj_f$log2FC_smaj <- smaj_f$log2FoldChange_scaled
luci_f$log2FC_luci <- luci_f$log2FoldChange_scaled

plot_df_heat <- Reduce(
  f = function(x, y) merge(x, y, by = "gene", all = FALSE),
  x = list(smaj_f, mart_f, luci_f)
)
plot_df_heat$same_dir_human = sign(plot_df_heat$log2FC_smaj) == sign(plot_df_heat$log2FC_mart)
plot_df_heat$same_dir_all = sign(plot_df_heat$log2FC_mart) == sign(plot_df_heat$log2FC_luci)
sameAll <- plot_df$gene[which(plot_df_heat$same_dir_human == TRUE & plot_df_heat$same_dir_all == TRUE)]

pheatmap(
  heatmat[sameAll,],
  color = palette,
  breaks = breaks,
  cluster_rows = TRUE,
  cluster_cols = TRUE,
  fontsize_row = 10,
  fontsize_col = 8,
  main         = "log2FC heatmap (scaled to ±4)"
)

